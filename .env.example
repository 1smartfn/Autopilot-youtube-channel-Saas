# Optional: Google Gemini API key for live AI trend analysis, channel cloning,
# Wan 2.1 prompt engineering, and YouTube SEO generation.
# When omitted, the server gracefully falls back to curated local responses.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Server HTTP port (defaults to 3000)
PORT=3000

# Runtime environment: development | production
NODE_ENV=development

# Public URL where the app is hosted (used for self-referential links)
APP_URL="http://localhost:3000"

# Set to "true" to disable Vite HMR file watching in headless environments
# DISABLE_HMR=false
