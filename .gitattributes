# Normalize text files to LF across Windows, macOS, and Linux
* text=auto eol=lf

# Windows batch files
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets
*.docx binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.mp4 binary
*.webm binary
